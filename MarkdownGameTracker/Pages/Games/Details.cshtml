@page "{id}"
@model MarkdownGameTracker.Pages.Games.DetailsModel
@{
    ViewData["Title"] = Model.Game.Title;
}

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert success-alert" role="status">@Model.SuccessMessage</div>
}

<div class="note-header">
    <div>
        <a class="back-link" asp-page="/Index">← Back to games</a>
        <div class="note-meta">
            <span class="status-pill @IndexModel.GetStatusClass(Model.Game.Status)">@(Model.Game.Status is null ? "No status" : GameStatuses.GetLabel(Model.Game.Status))</span>
            @if (Model.Game.Rating is not null)
            {
                <span class="rating-pill">★ @Model.Game.Rating / 10</span>
            }
        </div>
        <h1>@Model.Game.Title</h1>
        <p class="file-hint">Games/@(Model.Game.Id).md</p>
    </div>
    <div class="note-actions">
        <a class="btn btn-primary" asp-page="/Games/Edit" asp-route-id="@Model.Game.Id">Edit note</a>
        <button class="btn btn-danger-soft" type="button" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
    </div>
</div>

<section class="game-media-panel"
         aria-labelledby="gameArtworkHeading"
         data-game-media
         data-game-title="@Model.Game.Title"
         hidden>
    <h2 class="visually-hidden" id="gameArtworkHeading">Artwork for @Model.Game.Title</h2>
    <div class="game-hero-frame" data-game-hero-frame>
        <img class="game-hero-image" data-game-hero alt="" referrerpolicy="no-referrer" hidden>
        <div class="game-hero-overlay">
            <img class="game-cover-image"
                 data-game-cover
                 alt="Cover art for @Model.Game.Title"
                 referrerpolicy="no-referrer"
                 hidden>
            <span class="game-artwork-credit">Artwork from IGDB</span>
        </div>
    </div>
    <div class="game-screenshot-section" data-game-screenshots hidden>
        <div class="game-screenshot-heading">
            <div>
                <span class="eyebrow">Gallery</span>
                <h3>Screenshots</h3>
            </div>
            <span>Open any image at full size</span>
        </div>
        <div class="game-screenshot-grid" data-game-screenshot-grid></div>
    </div>
</section>

<section class="game-description-card"
         aria-labelledby="gameDescriptionHeading"
         data-game-description
         data-game-id="@Model.Game.Id"
         data-description-url="/api/games/@Uri.EscapeDataString(Model.Game.Id)/igdb-description"
         data-matches-url="/api/games/@Uri.EscapeDataString(Model.Game.Id)/igdb-matches">
    <div class="game-description-heading">
        <div>
            <span class="eyebrow">Game overview</span>
            <h2 id="gameDescriptionHeading">About the game</h2>
        </div>
        <span class="igdb-badge">IGDB</span>
    </div>
    <div class="game-description-body" data-description-body role="status" aria-live="polite">
        <p class="description-placeholder">Looking up a description…</p>
    </div>
    <div class="game-description-footer" data-description-footer hidden>
        <span data-description-match>Fetched live · not stored in your note</span>
        <div class="game-description-actions">
            <button class="igdb-match-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="igdbMatchPicker"
                    data-match-toggle
                    hidden>
                Choose another match
            </button>
            <a data-description-source target="_blank" rel="noopener noreferrer" hidden>View on IGDB ↗</a>
        </div>
    </div>
    <div class="igdb-match-picker" id="igdbMatchPicker" data-match-picker hidden>
        <div class="igdb-match-picker-heading">
            <div>
                <span class="eyebrow">IGDB search</span>
                <h3>Choose the right game</h3>
            </div>
            <span>Release years help distinguish remakes and similarly named games.</span>
        </div>
        <div class="igdb-match-list" data-match-list role="status" aria-live="polite"></div>
    </div>
</section>

<div class="note-layout">
    <article class="note-card">
        <div class="note-card-heading">
            <span class="eyebrow">Markdown</span>
            <span>Stored in Obsidian</span>
        </div>
        @if (string.IsNullOrWhiteSpace(Model.Game.Markdown))
        {
            <div class="empty-note">
                <p>This note is empty.</p>
                <a asp-page="/Games/Edit" asp-route-id="@Model.Game.Id">Add some thoughts →</a>
            </div>
        }
        else
        {
            <div class="markdown-body markdown-content">@Html.Raw(Model.RenderedMarkdown)</div>
        }
    </article>

    <aside class="metadata-card">
        <span class="eyebrow">Frontmatter</span>
        <h2>Note data</h2>
        <dl>
            <div>
                <dt>Type</dt>
                <dd>game</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>@(Model.Game.Status is null ? "—" : GameStatuses.GetLabel(Model.Game.Status))</dd>
            </div>
            <div>
                <dt>Rating</dt>
                <dd>@(Model.Game.Rating?.ToString() ?? "—")</dd>
            </div>
            @foreach (var item in Model.ExtraFrontmatter)
            {
                <div>
                    <dt>@item.Key</dt>
                    <dd>@DetailsModel.FormatFrontmatterValue(item.Value)</dd>
                </div>
            }
        </dl>
        <span class="updated-time">Updated @Model.Game.LastModifiedUtc.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</span>
    </aside>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content soft-modal">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="deleteModalLabel">Delete @Model.Game.Title?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                This permanently deletes <strong>@(Model.Game.Id).md</strong> from your vault.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-bs-dismiss="modal">Keep it</button>
                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Game.Id">
                    <button type="submit" class="btn btn-danger">Delete note</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/game-description.js" asp-append-version="true"></script>
}
