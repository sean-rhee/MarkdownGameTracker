@page
@model IndexModel
@{
    ViewData["Title"] = "My games";
}

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert success-alert" role="status">@Model.SuccessMessage</div>
}

<section class="hero-panel">
    <div class="journal-intro">
        <span class="eyebrow">Your personal game journal</span>
        <h1>What are you <em>playing?</em></h1>
        <p>Track the backlog, remember where you left off, and keep every thought in Markdown.</p>
    </div>
    <div class="journal-aside">
        <span class="journal-total">@Model.StatusTabs.Sum(tab => tab.Count).ToString("D2")</span>
        <span class="journal-caption">games in your garden</span>
        <a class="btn btn-primary" asp-page="/Games/Create">+ Add a game</a>
    </div>
</section>

<section class="library-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Your collection</span>
            <h2>Game notes</h2>
        </div>
        <span class="result-count" data-search-result-count aria-live="polite">
            @Model.VisibleGameCount @(Model.VisibleGameCount == 1 ? "result" : "results")
        </span>
    </div>

    <nav class="status-tabs" aria-label="Game status">
        @foreach (var tab in Model.StatusTabs)
        {
            <a class="status-tab @(tab.Value == Model.SelectedStatus ? "active" : null)"
               asp-page="/Index"
               asp-route-status="@tab.Value"
               asp-route-search="@Model.Search"
               aria-current="@(tab.Value == Model.SelectedStatus ? "page" : null)">
                <span>@tab.Label</span>
                <span class="status-tab-count">@tab.Count</span>
            </a>
        }
    </nav>

    <form method="get" class="filter-bar">
        <input asp-for="Status" type="hidden" />
        <div class="filter-field filter-search">
            <label asp-for="Search">Search</label>
            <div class="search-combobox" data-search-suggestions>
                <input asp-for="Search"
                       class="form-control"
                       placeholder="Title or notes…"
                       autocomplete="off"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-controls="searchSuggestions"
                       aria-expanded="false" />
                <ul id="searchSuggestions" class="search-suggestions" role="listbox" hidden>
                    @foreach (var title in Model.SearchSuggestions)
                    {
                        <li role="option"
                            aria-selected="false"
                            data-search-suggestion
                            data-search-value="@title">@title</li>
                    }
                </ul>
            </div>
        </div>
        <button class="btn btn-secondary" type="submit">Search</button>
        <a class="btn btn-link"
           asp-page="/Index"
           asp-route-status="@Model.SelectedStatus"
           data-search-clear
           hidden="@string.IsNullOrWhiteSpace(Model.Search)">Clear</a>
    </form>

    <div class="empty-state" data-search-empty-state hidden="@(Model.VisibleGameCount != 0)">
        <div class="empty-icon" aria-hidden="true">✦</div>
        <h3>No @GameStatuses.GetLabel(Model.SelectedStatus).ToLowerInvariant() games found</h3>
        <p>Try clearing the search or add a game to this list.</p>
        <a class="btn btn-primary" asp-page="/Games/Create">Add a game</a>
    </div>

    <div class="game-grid"
         data-game-artwork-grid
         data-search-results
         data-artwork-url="/api/games/igdb-card-artwork"
         hidden="@(Model.VisibleGameCount == 0)">
        @foreach (var game in Model.Games)
        {
            <article class="game-card"
                     data-game-card
                     data-game-id="@game.Id"
                     data-search-text="@IndexModel.GetSearchText(game)"
                     hidden="@(!Model.IsSearchMatch(game))">
                <div class="game-card-artwork" data-game-card-artwork hidden>
                    <img data-game-card-image loading="lazy" decoding="async" alt="" />
                </div>
                <div class="game-card-content">
                    <div class="game-card-top">
                        <partial name="_InlineStatusControl"
                                 model="@(new InlineStatusControlModel(game.Id, game.Status, "/Index", Model.SelectedStatus, Model.Search))" />
                        <partial name="_InlineRatingControl"
                                 model="@(new InlineRatingControlModel(game.Id, game.Rating, "/Index", Model.SelectedStatus, Model.Search))" />
                    </div>
                    <h3>@game.Title</h3>
                    @if (IndexModel.GetPlatform(game) is { } platform)
                    {
                        <span class="game-card-platform">@platform</span>
                    }
                    <p>@IndexModel.GetExcerpt(game.Markdown)</p>
                    <div class="game-card-actions">
                        <a class="stretched-link" asp-page="/Games/Details" asp-route-id="@game.Id">Open note</a>
                        <span aria-hidden="true">→</span>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/game-card-artwork.js" asp-append-version="true"></script>
    <script src="~/js/search-suggestions.js" asp-append-version="true"></script>
}
